# 環境変数の設定見本。Django はこのファイルや .env を自動で読み込みません。
# PyCharm の Run Configuration > Environment variables、または
# PowerShell の $env:DJANGO_DEBUG = 'true' などで設定してください。
# このまま環境変数を設定しなくても、localhost の開発サーバーは起動できます。
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 独自の秘密値を OS / IDE に設定する場合のみ使用します。
# DEBUG=false では開発専用キーを拒否します。実際の値は Git に保存しません。
# DJANGO_SECRET_KEY=<private-random-value>

# SQLite はローカル確認専用です。PostgreSQL 接続設定とドライバは未導入です。
# 本番公開には docs/operations/runbook.md の運用設計も必要です。
